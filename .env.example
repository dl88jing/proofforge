# Copy to `.env.local`. Never commit secrets or keypairs.

# mock | devnet | testnet | custom
SOLANA_CLUSTER=mock

# Required when SOLANA_CLUSTER is not mock.
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional JSON secret-key array (64 bytes). If unset, ProofForge generates
# data/keys/payer.json on first settle (gitignored).
# SOLANA_PAYER_SECRET=[1,2,3,...]

# Optional payee address. If unset, data/keys/payee.json is generated.
# SOLANA_PAYEE_PUBKEY=

# Lamports transferred after Avery accepts a Proof Pack.
SETTLE_LAMPORTS=1000

# Optional. Public GitHub issues work without a token.
# GITHUB_TOKEN=

# Optional override. Default: data/proofforge.db
# PROOFORGE_DB_PATH=
