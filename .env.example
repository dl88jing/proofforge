# Copy to `.env.local`. Never commit secrets or keypairs.

# ── Settlement ──────────────────────────────────────────────────────────────
# Default settle target shown in the UI: mock | devnet | testnet | custom
# "mock" = in-process JSON-RPC cluster (same @solana/web3.js tx path, no network).
SOLANA_CLUSTER=mock

# Live cluster offered by the mock/live toggle when SOLANA_CLUSTER=mock.
# SOLANA_LIVE_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Live payer = Avery's treasury. JSON 64-byte secret-key array or base58.
# Locally, `npm run devnet:setup` creates data/keys/payer.json instead (gitignored).
# Required on Vercel to enable live settle. Devnet only — never a mainnet key.
# SOLANA_PAYER_SECRET=[1,2,3,...]

# Optional live payee (Morgan's wallet). Default: deterministic demo address.
# SOLANA_PAYEE_PUBKEY=

# Lamports per accepted Proof Pack. Live settle auto-raises the first payout to
# the rent-exempt floor if the payee account does not exist yet.
SETTLE_LAMPORTS=1000

# ── State store ─────────────────────────────────────────────────────────────
# file (local default) | memory (Vercel default) | redis (auto when vars below set)
# PROOFFORGE_STORE=file
# PROOFFORGE_STORE_PATH=data/proofforge.json
# Upstash Redis / Vercel KV REST credentials → durable state across serverless instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PROOFFORGE_STORE_KEY=northbridge:proofforge:store
# Set to 0 to disable the public "Reset demo" endpoint.
# PROOFFORGE_ALLOW_RESET=1

# ── Intake ──────────────────────────────────────────────────────────────────
# Optional. Public GitHub issues work without a token (rate-limited).
# GITHUB_TOKEN=
